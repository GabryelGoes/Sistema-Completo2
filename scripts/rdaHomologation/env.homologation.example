# Copie para .env.homologation (NÃO commitar). Use APENAS o projeto Supabase de TESTE.
# Não cole URLs/chaves do ambiente de produção.
# Não envie este arquivo nem as chaves pelo chat.

# Confirmação obrigatória para o runner dos 22 testes (anti-produção)
HOMOLOGATION_OK=rei-do-abs-homologacao

# --- Supabase TESTE (Dashboard → Project Settings → API) ---
SUPABASE_URL=https://SEU_PROJECT_REF_TESTE.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service_role_do_projeto_teste
SUPABASE_VEHICLE_PHOTOS_BUCKET=vehicle-photos

# Anon do projeto TESTE (obrigatória para o item 22 do runner automático)
VITE_SUPABASE_URL=https://SEU_PROJECT_REF_TESTE.supabase.co
VITE_SUPABASE_ANON_KEY=anon_do_projeto_teste
VITE_WORKSHOP_ID=11111111-1111-4111-8111-111111111111

# --- Oficina fictícia (mesmo UUID do seed 01_seed_fictional.sql) ---
WORKSHOP_ID=11111111-1111-4111-8111-111111111111

# Senhas/segredos NOVOS (não reutilizar produção)
ADMIN_PASSWORD=homolog-admin-troque-isto
SESSION_SECRET=homolog-session-secret-aleatorio-longo

# RDA permanece desligado para IA; APIs de tempo/avaliações funcionam via backend
RDA_INTELLIGENCE_ENABLED=false
RDA_ALLOW_LLM_CALLS=false
RDA_LLM_PROVIDER=noop
# OPENAI_API_KEY=   # deixar vazio

# Porta opcional do servidor efêmero do runner (0 = aleatória)
# RDA_HOMOLOG_PORT=0
