# =============================================================================
# Variáveis para um PREVIEW ISOLADO (Vercel) — projeto rei-do-abs-homologacao
# =============================================================================
# COMO CADASTRAR (sem colar chaves neste chat / sem commitar):
#   Preferido: projeto Vercel SEPARADO (ex.: sistema-completo2-homolog)
#   ligado ao mesmo repositório, branch cursor/rda-intelligence-485b.
#   Em Settings → Environment Variables, cadastre as chaves abaixo
#   apenas no escopo Production e Preview DESSE projeto de homologação.
#
# NÃO altere Environment Variables do deployment de PRODUÇÃO do app principal.
# NÃO use URL/service_role do banco da oficina.
# =============================================================================

# --- Obrigatórias (servidor / API) ---
HOMOLOGATION_MODE=true
HOMOLOGATION_OK=rei-do-abs-homologacao
SUPABASE_URL=https://SEU_REF_HOMOLOG.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole_service_role_do_projeto_teste
WORKSHOP_ID=11111111-1111-4111-8111-111111111111
ADMIN_PASSWORD=senha-forte-unica-so-para-homolog-gerencia
SESSION_SECRET=string-aleatoria-longa-unica-homolog

# IA desligada
RDA_INTELLIGENCE_ENABLED=false
RDA_ALLOW_LLM_CALLS=false
RDA_LLM_PROVIDER=noop
# OPENAI_API_KEY=   (deixar ausente)

# Storage (nomes padrão; buckets podem não existir — uploads opcionais no teste RDA)
SUPABASE_VEHICLE_PHOTOS_BUCKET=vehicle-photos

# TV: NÃO deixe rotas de TV abertas no preview público
TV_API_TOKEN=token-aleatorio-homolog-tv

# --- Build / frontend (Vite) — mesmo projeto TESTE ---
VITE_SUPABASE_URL=https://SEU_REF_HOMOLOG.supabase.co
VITE_SUPABASE_ANON_KEY=cole_anon_key_do_projeto_teste
VITE_WORKSHOP_ID=11111111-1111-4111-8111-111111111111
# Em preview na mesma origem, deixe VITE_API_BASE vazio (usa /api relativo).

# --- Proteção de acesso à URL ---
# Além do login do app, ative no Vercel:
#   Project → Settings → Deployment Protection
#   → Standard Protection ou Password Protection
# Assim a URL não fica aberta na internet com usuários fictícios.
