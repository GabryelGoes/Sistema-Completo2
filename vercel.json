{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "includeFiles": "{apiApp.ts,supabaseClient.ts,constants/**,utils/**,services/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?__path=:path*" }
  ]
}
