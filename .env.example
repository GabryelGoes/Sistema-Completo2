# Copie para .env e preencha. Nunca commite .env (está no .gitignore).
# Frontend (Vite) — prefixe com VITE_ para expor no cliente.

# --- API (obrigatório no build do app Android/Capacitor) ---
# URL completa da API em produção, terminando em /api (ex.: https://seu-dominio.com/api).
# Sem isso, o app web usa /api relativo ao mesmo host (dev + deploy com front e API juntos).
# VITE_API_BASE=https://seu-dominio.com/api

# --- URL pública do app (link de acompanhamento do cliente) ---
# Use a URL do front na Vercel (sem barra final). Obrigatório se o build não for servido na mesma origem do link copiado.
# VITE_PUBLIC_APP_URL=https://sistema-completo2.vercel.app

# --- Trello / Atlassian ---
VITE_TRELLO_API_KEY=sua_api_key_aqui
VITE_TRELLO_TOKEN=seu_token_aqui
VITE_TRELLO_LIST_ID=id_da_lista_principal
VITE_TRELLO_AGENDAMENTO_LIST_ID=id_da_lista_agendamento

# --- Supabase (servidor) ---
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key
SUPABASE_VEHICLE_PHOTOS_BUCKET=vehicle-photos

# --- Supabase no browser (Realtime — reduz custo Vercel; opcional mas recomendado) ---
# Mesmo projeto: URL pública + anon key (Settings → API). Nunca use service_role no front.
# VITE_SUPABASE_URL=https://seu-projeto.supabase.co
# VITE_SUPABASE_ANON_KEY=sua_anon_key
# O mesmo UUID da oficina que WORKSHOP_ID (filtros de lembretes / hub no Realtime).
# VITE_WORKSHOP_ID=uuid_da_oficina_em_workshops

# --- Oficina e auth ---
WORKSHOP_ID=uuid_da_oficina_em_workshops
# Senha da Gerência. Em produção é OBRIGATÓRIA (sem ela, não há fallback inseguro).
ADMIN_PASSWORD=senha_gerencia
# Segredo para assinar os tokens de sessão (HMAC). Use uma string longa e aleatória.
# Se não definido, deriva da SUPABASE_SERVICE_ROLE_KEY automaticamente.
# SESSION_SECRET=troque_por_uma_string_aleatoria_longa

# --- CORS (API) — se o front e a API estiverem em domínios diferentes (ex.: VITE_API_BASE=https://outro.com/api) ---
# Liste as origens do app (sem barra final), separadas por vírgula. Sem isso o navegador mostra "Failed to fetch".
# CORS_ALLOWED_ORIGINS=https://meu-app.vercel.app,https://outro-dominio.com

# --- TVs (Pátio + Laboratório) — CORS na API do app principal (servidor) ---
# Deploys separados: patio-view.vercel.app e laboratorio-view.vercel.app são sempre permitidos.
# Opcional: PATIO_VIEW_ORIGINS=url1,url2 (sem barra final) para domínios extras.
#
# Em cada projeto TV (Patio-View / Laboratorio-View): VITE_API_BASE=https://seu-dominio.com/api
#
# Token de leitura das TVs (rodam sem login). Se definido aqui, as TVs precisam enviar o
# mesmo valor em VITE_TV_TOKEN (nos projetos Patio-View/Laboratorio-View). Se NÃO definido,
# as rotas de leitura da TV (GET /api/tv/playlist e GET /api/service-orders) ficam abertas.
# TV_API_TOKEN=defina_um_token_aleatorio_e_use_o_mesmo_em_VITE_TV_TOKEN

# --- PlacaFipe (opcional — consulta veículo por placa na Recepção; só no servidor) ---
# Obtenha o token em https://www.placafipe.com.br — não use prefixo VITE_ (nunca exponha no front).
PLACAFIPE_TOKEN=

